// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  PROVIDER
  VENDOR
}

enum UserStatus {
  ACTIVE
  BLOCKED
  SUSPENDED
  INACTIVE
}

enum AdminUserRole {
  SUPER_ADMIN
  OPERATIONS_ADMIN
  FINANCE_ADMIN
  SUPPORT_AGENT
  COMPLIANCE_OFFICER
}

enum DocumentType {
  AADHAAR_CARD
  PAN_CARD
  DRIVING_LICENSE
  VOTER_ID
  PASSPORT
  BANK_STATEMENT
  ADDRESS_PROOF
}

enum KYCStatus {
  PENDING
  APPROVED
  REJECTED
  UNDER_REVIEW
}

enum VerificationLevel {
  LEVEL_1
  LEVEL_2
  LEVEL_3
}

enum BookingStatus {
  PENDING_ASSIGNMENT
  ASSIGNED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  CANCELLED
}

enum SettlementStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  CANCELLED
}

enum ActionType {
  CREATE
  UPDATE
  DELETE
  VIEW
  APPROVE
  REJECT
  BLOCK
  UNBLOCK
  SUSPEND
  ASSIGN
  REASSIGN
  CANCEL
  PROCESS
  EXPORT
  LOGIN
  LOGOUT
}

enum EntityType {
  USER
  BOOKING
  KYC
  PRICING
  PAYOUT
  SETTLEMENT
  SERVICE
  PROVIDER
  VENDOR
  SYSTEM
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum ReferenceType {
  BOOKING
  PAYOUT
  REFUND
  TOPUP
  COMMISSION
}

model AdminUser {
  id        String        @id @default(uuid())
  name      String
  email     String        @unique
  password  String
  role      AdminUserRole @default(SUPPORT_AGENT)
  phone     String?
  avatar    String?
  isActive  Boolean       @default(true)
  lastLogin DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  kycReviews    KYCApplication[]
  auditLogs     AuditLog[]

  @@map("admin_users")
}

model User {
  id              String      @id @default(uuid())
  name            String
  phone           String      @unique
  email           String      @unique
  role            UserRole
  status          UserStatus  @default(ACTIVE)
  lastLogin       DateTime?
  isVerified      Boolean     @default(true)
  avatar          String?
  address         Json?
  registrationDate DateTime   @default(now())
  updatedAt       DateTime    @updatedAt

  bookingsAsCustomer Booking[] @relation("CustomerBookings")
  bookingsAsProvider Booking[] @relation("ProviderBookings")
  kycApplications   KYCApplication[]

  @@map("users")
}

model KYCApplication {
  id              String            @id @default(uuid())
  providerId      String
  provider        User              @relation(fields: [providerId], references: [id])
  documentType    DocumentType
  documents       Json
  status          KYCStatus         @default(PENDING)
  verificationLevel VerificationLevel @default(LEVEL_1)
  reviewerId      String?
  reviewer        AdminUser?        @relation(fields: [reviewerId], references: [id])
  remarks         String?
  rejectionReason String?
  uploadedDate    DateTime          @default(now())
  reviewedDate    DateTime?

  @@map("kyc_applications")
}

model Booking {
  id                String        @id @default(uuid())
  bookingNumber     String        @unique
  serviceId         String
  serviceName       String
  serviceCategory   String
  customerId        String
  customer          User          @relation("CustomerBookings", fields: [customerId], references: [id])
  providerId        String?
  provider          User?         @relation("ProviderBookings", fields: [providerId], references: [id])
  status            BookingStatus @default(PENDING_ASSIGNMENT)
  paymentStatus     PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(10, 2)
  location          Json
  scheduledDate     DateTime
  completedDate     DateTime?
  cancelledDate     DateTime?
  cancellationReason String?
  estimatedDuration String
  actualDuration    String?
  paymentMethod     String?
  specialInstructions String?
  adminNotes        String?
  bookingDate       DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("bookings")
}

model ServicePricing {
  id                String    @id @default(uuid())
  serviceId         String
  serviceName       String
  serviceCategory   String
  city              String
  basePrice         Decimal   @db.Decimal(10, 2)
  surgeMultiplier   Decimal   @default(1.0) @db.Decimal(5, 2)
  providerCommission Decimal  @db.Decimal(5, 2)
  vendorCommission  Decimal    @db.Decimal(5, 2)
  status            Boolean   @default(true)
  version           Int       @default(1)
  effectiveFrom     DateTime
  effectiveTo        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("service_pricing")
}

model SurgePricingRule {
  id                String    @id @default(uuid())
  name              String
  description       String?
  multiplier        Decimal   @db.Decimal(5, 2)
  days              String[]
  timeFrom          String?
  timeTo            String?
  cities            String[]
  serviceCategories String[]
  status            Boolean   @default(true)
  priority          Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("surge_pricing_rules")
}

model ProviderPayout {
  id            String        @id @default(uuid())
  providerId    String
  providerName  String
  providerPhone String?
  periodFrom    DateTime
  periodTo      DateTime
  totalEarnings Decimal       @db.Decimal(10, 2)
  commission    Decimal       @db.Decimal(10, 2)
  deductions    Decimal       @default(0) @db.Decimal(10, 2)
  payoutAmount  Decimal       @db.Decimal(10, 2)
  status        PayoutStatus  @default(PENDING)
  dueDate       DateTime
  processedDate DateTime?
  paymentMethod String?
  accountDetails Json?
  transactionId String?
  remarks       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("provider_payouts")
}

model VendorSettlement {
  id              String            @id @default(uuid())
  vendorId        String
  vendorName      String
  vendorPhone     String?
  periodFrom      DateTime
  periodTo        DateTime
  totalRevenue    Decimal           @db.Decimal(10, 2)
  commission      Decimal           @db.Decimal(10, 2)
  settlementAmount Decimal          @db.Decimal(10, 2)
  status          SettlementStatus  @default(PENDING)
  dueDate         DateTime
  processedDate   DateTime?
  paymentMethod   String?
  accountDetails  Json?
  transactionId   String?
  remarks         String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("vendor_settlements")
}

model WalletTransaction {
  id            String        @id @default(uuid())
  userId        String
  userType      String
  type          TransactionType
  amount        Decimal       @db.Decimal(10, 2)
  balance       Decimal       @db.Decimal(10, 2)
  description   String        @db.Text
  referenceType ReferenceType
  referenceId   String
  status        Boolean       @default(true)
  timestamp     DateTime      @default(now())

  @@map("wallet_transactions")
}

model AuditLog {
  id            String      @id @default(uuid())
  adminUserId   String
  adminUser     AdminUser   @relation(fields: [adminUserId], references: [id])
  actionType    ActionType
  action        String
  entityType    EntityType
  entityId      String
  entityName    String
  details       String      @db.Text
  changes       Json?
  ipAddress     String
  userAgent     String?
  status        Boolean     @default(true)
  errorMessage  String?
  sessionId     String
  timestamp     DateTime    @default(now())

  @@map("audit_logs")
}
